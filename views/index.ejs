<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>FindBack</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
</head>

<body>

    <header class="site-header">

        <nav class="navbar">

            <a href="/" class="logo">
                <img src="/images/logo.png" alt="FindBack Logo" class="navbar-logo">
            </a>

            <div class="nav-links">
                <a href="/" class="active">Home</a>
                <a href="/browse" class="search-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </a>
                <a href="/report-item">Report Item</a>
            </div>

            <div class="nav-buttons">
                <a href="/login" class="login-button">
                    Login
                </a>

                <a href="/register" class="register-button">
                    Register
                </a>
            </div>

        </nav>

    </header>

    <main>

        <section class="hero-section">

            <div class="hero-text">

                <h1>
                    Lost something?
                    <span>Found something?</span>
                </h1>

                <p>
                    Let’s help each other.
                    <br>
                    Find and return items
                    <br>
                    around our campus.
                </p>

                <div class="hero-buttons">

                    <a
                        href="/report-item"
                        class="report-lost-button"
                    >
                        Report Lost Item
                    </a>

                    <a
                        href="/report-item"
                        class="report-found-button"
                    >
                        Report Found Item
                    </a>

                </div>

            </div>

            <div class="hero-image-area">

                <span class="heart heart-one">♡</span>
                <span class="heart heart-two">♡</span>
                <span class="heart heart-three">♡</span>

                <img
                    src="/images/hero-items.png"
                    alt="Pink backpack, handbag and teddy bear"
                    class="hero-image"
                >

            </div>

        </section>

    </main>

</body>
</html>